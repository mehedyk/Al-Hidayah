{
  "name": "al-hidayah",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": "24.x",
    "pnpm": "12.21.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "pnpm data:build && pnpm data:validate && pnpm data:verify && astro build",
    "preview": "astro preview",
    "data:fetch": "tsx scripts/fetch-data.ts",
    "data:validate": "tsx scripts/validate-data.ts",
    "data:build": "tsx scripts/build-data.ts",
    "data:verify": "tsx scripts/verify-checksums.ts",
    "wallpapers:fetch": "tsx scripts/fetch-wallpapers.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "astro check",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:visual": "playwright test tests/visual",
    "release-gate": "pnpm lint && pnpm typecheck && pnpm data:validate && pnpm data:verify && pnpm test && pnpm build"
  },
  "dependencies": {
    "@astrojs/preact": "6.1.6",
    "@fontsource/amiri": "5.3.0",
    "@fontsource/amiri-quran": "5.3.0",
    "@fontsource/cormorant-garamond": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/noto-serif-bengali": "5.3.0",
    "astro": "7.4.12",
    "gsap": "3.15.1",
    "html-to-image": "1.11.13",
    "preact": "11.2.0",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "@types/three": "0.187.0",
    "eslint": "10.15.0",
    "eslint-plugin-astro": "3.2.1",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "prettier-plugin-astro": "1.1.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.0"
  }
}
