{"number":94,"name":"سُورَةُ الشَّرۡحِ","englishName":"Ash-Sharh","englishNameTranslation":"The Consolation","numberOfAyahs":8,"items":[{"id":"q:94:1","ref":{"kind":"quran","surah":94,"ayah":1,"surahName":"Ash-Sharh","edition":{"ar":"Uthmani","en":"Saheeh International","bn":"Muhiuddin Khan"}},"ar":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ أَلَمْ نَشْرَحْ لَكَ صَدْرَكَ","en":"Did We not expand for you, [O Muhammad], your breast?","bn":"আমি কি আপনার বক্ষ উম্মুক্ত করে দেইনি?","categories":[],"contextUrl":"https://quran.com/94/1"},{"id":"q:94:2","ref":{"kind":"quran","surah":94,"ayah":2,"surahName":"Ash-Sharh","edition":{"ar":"Uthmani","en":"Saheeh International","bn":"Muhiuddin Khan"}},"ar":"وَوَضَعْنَا عَنكَ وِزْرَكَ","en":"And We removed from you your burden","bn":"আমি লাঘব করেছি আপনার বোঝা,","categories":[],"contextUrl":"https://quran.com/94/2"},{"id":"q:94:3","ref":{"kind":"quran","surah":94,"ayah":3,"surahName":"Ash-Sharh","edition":{"ar":"Uthmani","en":"Saheeh International","bn":"Muhiuddin Khan"}},"ar":"ٱلَّذِىٓ أَنقَضَ ظَهْرَكَ","en":"Which had weighed upon your back","bn":"যা ছিল আপনার জন্যে অতিশয় দুঃসহ।","categories":[],"contextUrl":"https://quran.com/94/3"},{"id":"q:94:4","ref":{"kind":"quran","surah":94,"ayah":4,"surahName":"Ash-Sharh","edition":{"ar":"Uthmani","en":"Saheeh International","bn":"Muhiuddin Khan"}},"ar":"وَرَفَعْنَا لَكَ ذِكْرَكَ","en":"And raised high for you your repute.","bn":"আমি আপনার আলোচনাকে সমুচ্চ করেছি।","categories":[],"contextUrl":"https://quran.com/94/4"},{"id":"q:94:5","ref":{"kind":"quran","surah":94,"ayah":5,"surahName":"Ash-Sharh","edition":{"ar":"Uthmani","en":"Saheeh International","bn":"Muhiuddin Khan"}},"ar":"فَإِنَّ مَعَ ٱلْعُسْرِ يُسْرًا","en":"For indeed, with hardship [will be] ease.","bn":"নিশ্চয় কষ্টের সাথে স্বস্তি রয়েছে।","categories":[],"contextUrl":"https://quran.com/94/5"},{"id":"q:94:6","ref":{"kind":"quran","surah":94,"ayah":6,"surahName":"Ash-Sharh","edition":{"ar":"Uthmani","en":"Saheeh International","bn":"Muhiuddin Khan"}},"ar":"إِنَّ مَعَ ٱلْعُسْرِ يُسْرًۭا","en":"Indeed, with hardship [will be] ease.","bn":"নিশ্চয় কষ্টের সাথে স্বস্তি রয়েছে।","categories":[],"contextUrl":"https://quran.com/94/6"},{"id":"q:94:7","ref":{"kind":"quran","surah":94,"ayah":7,"surahName":"Ash-Sharh","edition":{"ar":"Uthmani","en":"Saheeh International","bn":"Muhiuddin Khan"}},"ar":"فَإِذَا فَرَغْتَ فَٱنصَبْ","en":"So when you have finished [your duties], then stand up [for worship].","bn":"অতএব, যখন অবসর পান পরিশ্রম করুন।","categories":[],"contextUrl":"https://quran.com/94/7"},{"id":"q:94:8","ref":{"kind":"quran","surah":94,"ayah":8,"surahName":"Ash-Sharh","edition":{"ar":"Uthmani","en":"Saheeh International","bn":"Muhiuddin Khan"}},"ar":"وَإِلَىٰ رَبِّكَ فَٱرْغَب","en":"And to your Lord direct [your] longing.","bn":"এবং আপনার পালনকর্তার প্রতি মনোনিবেশ করুন।","categories":[],"contextUrl":"https://quran.com/94/8"}]}