{"number":109,"name":"سُورَةُ الكَافِرُونَ","englishName":"Al-Kaafiroon","englishNameTranslation":"The Disbelievers","numberOfAyahs":6,"items":[{"id":"q:109:1","ref":{"kind":"quran","surah":109,"ayah":1,"surahName":"Al-Kaafiroon","edition":{"ar":"Uthmani","en":"Saheeh International","bn":"Muhiuddin Khan"}},"ar":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ قُلْ يَٰٓأَيُّهَا ٱلْكَٰفِرُونَ","en":"Say, \"O disbelievers,","bn":"বলুন, হে কাফেরকূল,","categories":[],"contextUrl":"https://quran.com/109/1"},{"id":"q:109:2","ref":{"kind":"quran","surah":109,"ayah":2,"surahName":"Al-Kaafiroon","edition":{"ar":"Uthmani","en":"Saheeh International","bn":"Muhiuddin Khan"}},"ar":"لَآ أَعْبُدُ مَا تَعْبُدُونَ","en":"I do not worship what you worship.","bn":"আমি এবাদত করিনা, তোমরা যার এবাদত কর।","categories":[],"contextUrl":"https://quran.com/109/2"},{"id":"q:109:3","ref":{"kind":"quran","surah":109,"ayah":3,"surahName":"Al-Kaafiroon","edition":{"ar":"Uthmani","en":"Saheeh International","bn":"Muhiuddin Khan"}},"ar":"وَلَآ أَنتُمْ عَٰبِدُونَ مَآ أَعْبُدُ","en":"Nor are you worshippers of what I worship.","bn":"এবং তোমরাও এবাদতকারী নও, যার এবাদত আমি করি","categories":[],"contextUrl":"https://quran.com/109/3"},{"id":"q:109:4","ref":{"kind":"quran","surah":109,"ayah":4,"surahName":"Al-Kaafiroon","edition":{"ar":"Uthmani","en":"Saheeh International","bn":"Muhiuddin Khan"}},"ar":"وَلَآ أَنَا۠ عَابِدٌۭ مَّا عَبَدتُّمْ","en":"Nor will I be a worshipper of what you worship.","bn":"এবং আমি এবাদতকারী নই, যার এবাদত তোমরা কর।","categories":[],"contextUrl":"https://quran.com/109/4"},{"id":"q:109:5","ref":{"kind":"quran","surah":109,"ayah":5,"surahName":"Al-Kaafiroon","edition":{"ar":"Uthmani","en":"Saheeh International","bn":"Muhiuddin Khan"}},"ar":"وَلَآ أَنتُمْ عَٰبِدُونَ مَآ أَعْبُدُ","en":"Nor will you be worshippers of what I worship.","bn":"তোমরা এবাদতকারী নও, যার এবাদত আমি করি।","categories":[],"contextUrl":"https://quran.com/109/5"},{"id":"q:109:6","ref":{"kind":"quran","surah":109,"ayah":6,"surahName":"Al-Kaafiroon","edition":{"ar":"Uthmani","en":"Saheeh International","bn":"Muhiuddin Khan"}},"ar":"لَكُمْ دِينُكُمْ وَلِىَ دِينِ","en":"For you is your religion, and for me is my religion.\"","bn":"তোমাদের কর্ম ও কর্মফল তোমাদের জন্যে এবং আমার কর্ম ও কর্মফল আমার জন্যে।","categories":[],"contextUrl":"https://quran.com/109/6"}]}