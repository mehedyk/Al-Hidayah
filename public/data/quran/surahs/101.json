{"number":101,"name":"سُورَةُ القَارِعَةِ","englishName":"Al-Qaari'a","englishNameTranslation":"The Calamity","numberOfAyahs":11,"items":[{"id":"q:101:1","ref":{"kind":"quran","surah":101,"ayah":1,"surahName":"Al-Qaari'a","edition":{"ar":"Uthmani","en":"Saheeh International","bn":"Muhiuddin Khan"}},"ar":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ ٱلْقَارِعَةُ","en":"The Striking Calamity -","bn":"করাঘাতকারী,","categories":[],"contextUrl":"https://quran.com/101/1"},{"id":"q:101:2","ref":{"kind":"quran","surah":101,"ayah":2,"surahName":"Al-Qaari'a","edition":{"ar":"Uthmani","en":"Saheeh International","bn":"Muhiuddin Khan"}},"ar":"مَا ٱلْقَارِعَةُ","en":"What is the Striking Calamity?","bn":"করাঘাতকারী কি?","categories":[],"contextUrl":"https://quran.com/101/2"},{"id":"q:101:3","ref":{"kind":"quran","surah":101,"ayah":3,"surahName":"Al-Qaari'a","edition":{"ar":"Uthmani","en":"Saheeh International","bn":"Muhiuddin Khan"}},"ar":"وَمَآ أَدْرَىٰكَ مَا ٱلْقَارِعَةُ","en":"And what can make you know what is the Striking Calamity?","bn":"করাঘাতকারী সম্পর্কে আপনি কি জানেন ?","categories":[],"contextUrl":"https://quran.com/101/3"},{"id":"q:101:4","ref":{"kind":"quran","surah":101,"ayah":4,"surahName":"Al-Qaari'a","edition":{"ar":"Uthmani","en":"Saheeh International","bn":"Muhiuddin Khan"}},"ar":"يَوْمَ يَكُونُ ٱلنَّاسُ كَٱلْفَرَاشِ ٱلْمَبْثُوثِ","en":"It is the Day when people will be like moths, dispersed,","bn":"যেদিন মানুষ হবে বিক্ষিপ্ত পতংগের মত","categories":[],"contextUrl":"https://quran.com/101/4"},{"id":"q:101:5","ref":{"kind":"quran","surah":101,"ayah":5,"surahName":"Al-Qaari'a","edition":{"ar":"Uthmani","en":"Saheeh International","bn":"Muhiuddin Khan"}},"ar":"وَتَكُونُ ٱلْجِبَالُ كَٱلْعِهْنِ ٱلْمَنفُوشِ","en":"And the mountains will be like wool, fluffed up.","bn":"এবং পর্বতমালা হবে ধুনিত রঙ্গীন পশমের মত।","categories":[],"contextUrl":"https://quran.com/101/5"},{"id":"q:101:6","ref":{"kind":"quran","surah":101,"ayah":6,"surahName":"Al-Qaari'a","edition":{"ar":"Uthmani","en":"Saheeh International","bn":"Muhiuddin Khan"}},"ar":"فَأَمَّا مَن ثَقُلَتْ مَوَٰزِينُهُۥ","en":"Then as for one whose scales are heavy [with good deeds],","bn":"অতএব যার পাল্লা ভারী হবে,","categories":[],"contextUrl":"https://quran.com/101/6"},{"id":"q:101:7","ref":{"kind":"quran","surah":101,"ayah":7,"surahName":"Al-Qaari'a","edition":{"ar":"Uthmani","en":"Saheeh International","bn":"Muhiuddin Khan"}},"ar":"فَهُوَ فِى عِيشَةٍۢ رَّاضِيَةٍۢ","en":"He will be in a pleasant life.","bn":"সে সুখীজীবন যাপন করবে।","categories":[],"contextUrl":"https://quran.com/101/7"},{"id":"q:101:8","ref":{"kind":"quran","surah":101,"ayah":8,"surahName":"Al-Qaari'a","edition":{"ar":"Uthmani","en":"Saheeh International","bn":"Muhiuddin Khan"}},"ar":"وَأَمَّا مَنْ خَفَّتْ مَوَٰزِينُهُۥ","en":"But as for one whose scales are light,","bn":"আর যার পাল্লা হালকা হবে,","categories":[],"contextUrl":"https://quran.com/101/8"},{"id":"q:101:9","ref":{"kind":"quran","surah":101,"ayah":9,"surahName":"Al-Qaari'a","edition":{"ar":"Uthmani","en":"Saheeh International","bn":"Muhiuddin Khan"}},"ar":"فَأُمُّهُۥ هَاوِيَةٌۭ","en":"His refuge will be an abyss.","bn":"তার ঠিকানা হবে হাবিয়া।","categories":[],"contextUrl":"https://quran.com/101/9"},{"id":"q:101:10","ref":{"kind":"quran","surah":101,"ayah":10,"surahName":"Al-Qaari'a","edition":{"ar":"Uthmani","en":"Saheeh International","bn":"Muhiuddin Khan"}},"ar":"وَمَآ أَدْرَىٰكَ مَا هِيَهْ","en":"And what can make you know what that is?","bn":"আপনি জানেন তা কি?","categories":[],"contextUrl":"https://quran.com/101/10"},{"id":"q:101:11","ref":{"kind":"quran","surah":101,"ayah":11,"surahName":"Al-Qaari'a","edition":{"ar":"Uthmani","en":"Saheeh International","bn":"Muhiuddin Khan"}},"ar":"نَارٌ حَامِيَةٌۢ","en":"It is a Fire, intensely hot.","bn":"প্রজ্জ্বলিত অগ্নি!","categories":[],"contextUrl":"https://quran.com/101/11"}]}