{"number":114,"name":"سُورَةُ النَّاسِ","englishName":"An-Naas","englishNameTranslation":"Mankind","numberOfAyahs":6,"items":[{"id":"q:114:1","ref":{"kind":"quran","surah":114,"ayah":1,"surahName":"An-Naas","edition":{"ar":"Uthmani","en":"Saheeh International","bn":"Muhiuddin Khan"}},"ar":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ قُلْ أَعُوذُ بِرَبِّ ٱلنَّاسِ","en":"Say, \"I seek refuge in the Lord of mankind,","bn":"বলুন, আমি আশ্রয় গ্রহণ করিতেছি মানুষের পালনকর্তার,","categories":[],"contextUrl":"https://quran.com/114/1"},{"id":"q:114:2","ref":{"kind":"quran","surah":114,"ayah":2,"surahName":"An-Naas","edition":{"ar":"Uthmani","en":"Saheeh International","bn":"Muhiuddin Khan"}},"ar":"مَلِكِ ٱلنَّاسِ","en":"The Sovereign of mankind.","bn":"মানুষের অধিপতির,","categories":[],"contextUrl":"https://quran.com/114/2"},{"id":"q:114:3","ref":{"kind":"quran","surah":114,"ayah":3,"surahName":"An-Naas","edition":{"ar":"Uthmani","en":"Saheeh International","bn":"Muhiuddin Khan"}},"ar":"إِلَٰهِ ٱلنَّاسِ","en":"The God of mankind,","bn":"মানুষের মা’বুদের","categories":[],"contextUrl":"https://quran.com/114/3"},{"id":"q:114:4","ref":{"kind":"quran","surah":114,"ayah":4,"surahName":"An-Naas","edition":{"ar":"Uthmani","en":"Saheeh International","bn":"Muhiuddin Khan"}},"ar":"مِن شَرِّ ٱلْوَسْوَاسِ ٱلْخَنَّاسِ","en":"From the evil of the retreating whisperer -","bn":"তার অনিষ্ট থেকে, যে কুমন্ত্রণা দেয় ও আত্নগোপন করে,","categories":[],"contextUrl":"https://quran.com/114/4"},{"id":"q:114:5","ref":{"kind":"quran","surah":114,"ayah":5,"surahName":"An-Naas","edition":{"ar":"Uthmani","en":"Saheeh International","bn":"Muhiuddin Khan"}},"ar":"ٱلَّذِى يُوَسْوِسُ فِى صُدُورِ ٱلنَّاسِ","en":"Who whispers [evil] into the breasts of mankind -","bn":"যে কুমন্ত্রণা দেয় মানুষের অন্তরে","categories":[],"contextUrl":"https://quran.com/114/5"},{"id":"q:114:6","ref":{"kind":"quran","surah":114,"ayah":6,"surahName":"An-Naas","edition":{"ar":"Uthmani","en":"Saheeh International","bn":"Muhiuddin Khan"}},"ar":"مِنَ ٱلْجِنَّةِ وَٱلنَّاسِ","en":"From among the jinn and mankind.\"","bn":"জ্বিনের মধ্য থেকে অথবা মানুষের মধ্য থেকে।","categories":[],"contextUrl":"https://quran.com/114/6"}]}